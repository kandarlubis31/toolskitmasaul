/* Minimal Dark Theme - Clean & Professional */
QMainWindow, QWidget { background: #1e1e2e; color: #cdd6f4; font-size: 13px; }
#sidebar { background: #181825; border-right: 1px solid #313244; min-width: 200px; }
#sidebarAppTitle { font-size: 15px; font-weight: bold; color: #f38ba8; padding: 14px; }
#sidebarVersion { font-size: 10px; color: #585b70; padding: 0 14px 8px 14px; }

QPushButton { background: #313244; color: #cdd6f4; border: none; border-radius: 5px; padding: 8px 14px; }
QPushButton:hover { background: #45475a; }
QPushButton:checked { background: #313244; color: #f38ba8; border-left: 3px solid #f38ba8; }
#dangerButton { background: #a33737; }
#dangerButton:hover { background: #c04040; }

QGroupBox { background: #181825; border: 1px solid #313244; border-radius: 6px; margin-top: 12px; padding: 16px 12px 10px; font-weight: 600; }
QGroupBox::title { subcontrol-origin: margin; subcontrol-position: top left; padding: 2px 8px; color: #89b4fa; font-size: 11px; }

QTableWidget { background: #181825; color: #cdd6f4; border: 1px solid #313244; gridline-color: #252537; font-size: 12px; selection-background-color: #313244; }
QTableWidget::item { padding: 5px 8px; border-bottom: 1px solid #252537; }
QTableWidget::item:alternate { background: #1e1e30; }
QHeaderView::section { background: #252537; color: #a6adc8; padding: 6px 8px; border: none; font-weight: 600; font-size: 11px; }

QLineEdit, QSpinBox, QComboBox { background: #181825; color: #cdd6f4; border: 1px solid #313244; border-radius: 4px; padding: 6px 8px; }
QLineEdit:focus, QSpinBox:focus, QComboBox:focus { border-color: #89b4fa; }
QComboBox::drop-down { border: none; width: 20px; }
QComboBox QAbstractItemView { background: #181825; color: #cdd6f4; border: 1px solid #313244; selection-background-color: #313244; }

QProgressBar { background: #181825; border: 1px solid #313244; border-radius: 3px; text-align: center; color: #cdd6f4; height: 18px; font-size: 11px; }
QProgressBar::chunk { background: #89b4fa; border-radius: 2px; }

QTextEdit { background: #181825; color: #bac2de; border: 1px solid #313244; border-radius: 5px; padding: 8px; font-family: Consolas, monospace; font-size: 11px; }

QStatusBar { background: #181825; color: #585b70; border-top: 1px solid #313244; font-size: 11px; padding: 2px 8px; }

QScrollBar:vertical { background: #181825; width: 8px; }
QScrollBar::handle:vertical { background: #313244; border-radius: 4px; min-height: 30px; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }

QCheckBox { color: #cdd6f4; spacing: 6px; }
QCheckBox::indicator { width: 16px; height: 16px; border: 1px solid #313244; border-radius: 3px; background: #181825; }
QCheckBox::indicator:checked { background: #89b4fa; border-color: #89b4fa; }

#pageTitle { font-size: 20px; font-weight: bold; color: #f38ba8; padding: 12px 16px 4px; }
#cardValue { font-size: 16px; font-weight: bold; color: #cdd6f4; }
#cardStatus { font-size: 10px; font-weight: bold; color: #585b70; }
#statBox { background: #181825; border: 1px solid #313244; border-radius: 5px; padding: 4px; }
#statLabel { font-size: 9px; color: #585b70; text-transform: uppercase; }
#statValue { font-size: 13px; font-weight: 600; }
#statusDot { font-size: 14px; padding: 0 4px; }
#statusText { font-size: 12px; color: #a6adc8; padding: 0 8px; }
#resourceValue { font-size: 12px; color: #bac2de; font-weight: 600; min-width: 110px; }

/* Health card states */
#healthCard:hover { border: 1px solid #45475a; }

QTabWidget::pane { background: #181825; border: 1px solid #313244; border-radius: 5px; padding: 10px; }
QTabBar::tab { background: #181825; color: #585b70; padding: 6px 12px; font-size: 11px; }
QTabBar::tab:selected { color: #89b4fa; border-bottom: 2px solid #89b4fa; }
